# Copy this file to .env and paste your key (never commit .env):
#   cp .env.example .env && chmod 600 .env
# Create a key at https://platform.claude.com -> Settings -> API Keys
# (API billing is separate from a claude.ai Pro/Max subscription).
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Part 3 (Form Forge): SEC asks automated tools to declare who they are.
# Put YOUR name and a contact address you choose (never commit .env):
SEC_USER_AGENT="Your Name your.address@example.edu"
