      "text": "The script finds the first \"Average Value Weighted Returns -- Monthly\" block, maps the four needed columns by header name, and computes LT_Rev = 0.5\u00b7(SMALL LoPRIOR + BIG LoPRIOR) \u2212 0.5\u00b7(SMALL HiPRIOR + BIG HiPRIOR). Missing codes (-99.99 / -999) become NaN, and months lacking any required input are dropped.\n\n```python\nimport re\nimport numpy as np\nimport pandas as pd\n\nFILE = \"6_Portfolios_ME_Prior_60_13.csv\"\nOUT = \"output.csv\"\n\nwith open(FILE, encoding=\"latin-1\") as f:\n    lines = f.read().splitlines()\n\n# locate the FIRST value-weighted monthly block\nstart = None\nfor i, l in enumerate(lines):\n    if \"Average Value Weighted Returns -- Monthly\" in l:\n        start = i\n        break\nif start is None:\n    raise SystemExit(\"Value-weighted monthly block not found\")\n\n# header line: first non-empty line after the title\nhdr_idx = None\nfor j in range(start + 1, len(lines)):\n    if lines[j].strip():\n        hdr_idx = j\n        break\nheader = [h.strip() for h in lines[hdr_idx].split(\",\")]\n\ndef col(name):\n    for k, h in enumerate(header):\n        if h == name:\n            return k\n    raise KeyError(name)\n\nc_SL = col(\"SMALL LoPRIOR\")\nc_SH = col(\"SMALL HiPRIOR\")\nc_BL = col(\"BIG LoPRIOR\")\nc_BH = col(\"BIG HiPRIOR\")\n\nrecords = []\nstarted = False\nfor l in lines[hdr_idx + 1:]:\n    parts = [p.strip() for p in l.split(\",\")]\n    if parts and re.fullmatch(r\"\\d{6}\", parts[0]):\n        started = True\n        records.append(parts)\n    elif started:\n        break  # end of the monthly block\n\ndef to_num(s):\n    try:\n        v = float(s)\n    except ValueError:\n        return np.nan\n    if v <= -99.99 + 1e-9 and v >= -99.99 - 1e-9:\n        return np.nan\n    if v == -999:\n        return np.nan\n    return v\n\nout_rows = []\nfor p in records:\n    d = int(p[0])\n    try:\n        sl = to_num(p[c_SL]); sh = to_num(p[c_SH])\n        bl = to_num(p[c_BL]); bh = to_num(p[c_BH])\n    except IndexError:\n        continue\n    val = 0.5 * (sl + bl) - 0.5 * (sh + bh)\n    if np.isnan(val):\n        continue\n    out_rows.append((d, val))\n\nout = pd.DataFrame(out_rows, columns=[\"date\", \"value\"])\nout[\"date\"] = out[\"date\"].astype(int)\nout.to_csv(OUT, index=False)\nprint(f\"Wrote {len(out)} rows to {OUT}\")\n```",
