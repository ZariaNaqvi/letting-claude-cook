      "text": "The factor is the average of the two low-prior-return portfolios minus the average of the two high-prior-return portfolios, using the value-weighted monthly returns. The script parses only the monthly section, since the file also holds annual tables, and treats -99.99 and -999 as missing.\n\n```python\nimport re\n\nINPUT_FILE = \"6_Portfolios_ME_Prior_60_13.csv\"\nOUTPUT_FILE = \"output.csv\"\nMISSING = {-99.99, -999.0}\n\n\ndef parse_monthly_section(path):\n    with open(path, encoding=\"latin-1\") as f:\n        lines = f.read().splitlines()\n\n    # Locate the monthly value-weighted returns section\n    start = None\n    for i, line in enumerate(lines):\n        if \"Average Value Weighted Returns\" in line and \"Monthly\" in line:\n            start = i\n            break\n    if start is None:\n        raise RuntimeError(\"Monthly value-weighted section not found\")\n\n    rows = []\n    started = False\n    date_re = re.compile(r\"^\\d{6}$\")\n    for line in lines[start + 1:]:\n        s = line.strip()\n        if not s:\n            if started:\n                break  # end of monthly block\n            continue\n        parts = [p.strip() for p in s.split(\",\")]\n        if date_re.match(parts[0]) and len(parts) >= 7:\n            started = True\n            vals = []\n            for p in parts[1:7]:\n                try:\n                    v = float(p)\n                except ValueError:\n                    v = float(\"nan\")\n                if v in MISSING:\n                    v = float(\"nan\")\n                vals.append(v)\n            rows.append((int(parts[0]), vals))\n        else:\n            if started:\n                break  # reached next section\n    return rows\n\n\ndef main():\n    rows = parse_monthly_section(INPUT_FILE)\n\n    # Column order in file:\n    # 0 SMALL LoPRIOR, 1 ME1 PRIOR2, 2 SMALL HiPRIOR,\n    # 3 BIG LoPRIOR,   4 ME2 PRIOR2, 5 BIG HiPRIOR\n    out = []\n    for date, v in rows:\n        small_lo, small_hi = v[0], v[2]\n        big_lo, big_hi = v[3], v[5]\n        ret = 0.5 * (small_lo + big_lo) - 0.5 * (small_hi + big_hi)\n        if ret != ret:  # NaN check\n            continue\n        out.append((date, ret))\n\n    with open(OUTPUT_FILE, \"w\", encoding=\"utf-8\", newline=\"\") as f:\n        f.write(\"date,value\\n\")\n        for date, ret in out:\n            f.write(f\"{date},{ret:.6f}\\n\")\n\n\nif __name__ == \"__main__\":\n    main()\n```",
