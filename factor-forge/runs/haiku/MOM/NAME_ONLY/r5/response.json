      "citations": null,
      "text": "The factor is `UMD = 0.5*(Small High + Big High) - 0.5*(Small Low + Big Low)`, using the four corner portfolios of the 2x3 size-by-momentum sort. The script reads only the first monthly value-weighted block, treats -99.99 and -999 as missing, and drops any month where one of the four corner returns is missing.\n\n```python\nimport re\nimport numpy as np\nimport pandas as pd\n\nINPUT = \"6_Portfolios_ME_Prior_12_2.csv\"\nOUTPUT = \"output.csv\"\n\nMISSING_VALUES = (-99.99, -999.0)\n\n\ndef is_missing(x):\n    return any(np.isclose(x, m, rtol=0, atol=1e-9) for m in MISSING_VALUES)\n\n\ndef parse_monthly_block(path):\n    \"\"\"Parse the first 'Monthly' value-weighted block of the Ken French file.\n\n    Returns a DataFrame indexed by date (int YYYYMM) with the 6 portfolio\n    columns in file order. Missing codes are converted to NaN.\n    \"\"\"\n    rows = []\n    started = False\n    date_re = re.compile(r\"^\\d{6}$\")\n    with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n        for line in f:\n            parts = [p.strip() for p in line.strip().split(\",\")]\n            if len(parts) >= 7 and date_re.match(parts[0]):\n                try:\n                    vals = [float(x) for x in parts[1:7]]\n                except ValueError:\n                    if started:\n                        break\n                    continue\n                vals = [np.nan if is_missing(v) else v for v in vals]\n                rows.append([int(parts[0])] + vals)\n                started = True\n            else:\n                # End of the first monthly block (blank line or next section)\n                if started:\n                    break\n    cols = [\"date\", \"SL\", \"ME1P2\", \"SH\", \"BL\", \"ME2P2\", \"BH\"]\n    df = pd.DataFrame(rows, columns=cols)\n    df = df.drop_duplicates(subset=\"date\", keep=\"first\")\n    return df\n\n\ndef main():\n    df = parse_monthly_block(INPUT)\n\n    # Momentum factor (Ken French construction with 2x3 sorts):\n    # UMD = 1/2 (Small High + Big High) - 1/2 (Small Low + Big Low)\n    needed = [\"SH\", \"BH\", \"SL\", \"BL\"]\n    df = df.dropna(subset=needed).copy()\n    df[\"value\"] = 0.5 * (df[\"SH\"] + df[\"BH\"]) - 0.5 * (df[\"SL\"] + df[\"BL\"])\n\n    out = df[[\"date\", \"value\"]].copy()\n    out[\"date\"] = out[\"date\"].astype(int)\n    out = out.sort_values(\"date\").reset_index(drop=True)\n    out.to_csv(OUTPUT, index=False, columns=[\"date\", \"value\"])\n\n\nif __name__ == \"__main__\":\n    main()\n```",
